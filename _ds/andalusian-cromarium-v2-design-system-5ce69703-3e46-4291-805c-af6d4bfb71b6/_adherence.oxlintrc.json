{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "ui_kits/companion-app/**",
              "ui_kits/organizer-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Cormorant Garamond|Hanken Grotesk))/i]",
        "message": "Font not provided by the design system. Available: Cormorant Garamond, Hanken Grotesk."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:initial|src|size|gradient|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: initial, src, size, gradient, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|color|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, variant, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:province|index)$/]",
        "message": "<Badge> variant must be one of 'province' | 'index'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|iconRight|disabled|fullWidth|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, iconRight, disabled, fullWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:prism|navy|glass|ghost)$/]",
        "message": "<Button> variant must be one of 'prism' | 'navy' | 'glass' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|active|color|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children, active, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ColorDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|state|size|label|style|key|ref|className|style|children)$/]",
        "message": "<ColorDot> doesn't accept that prop. Declared props: color, state, size, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ColorDot'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:filled|checked|locked)$/]",
        "message": "<ColorDot> state must be one of 'filled' | 'checked' | 'locked'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|hero|tone|elevation|padding|interactive|style|key|ref|className|style|children)$/]",
        "message": "<GlassCard> doesn't accept that prop. Declared props: children, hero, tone, elevation, padding, interactive, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:none|prism|cyan|violet|fuchsia|gold|success|blue|pink|green|orange|yellow)$/]",
        "message": "<GlassCard> tone must be one of 'none' | 'prism' | 'cyan' | 'violet' | 'fuchsia' | 'gold' | 'success' | 'blue' | 'pink' | 'green' | 'orange' | 'yellow'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassCard'] > JSXAttribute[name.name='elevation'] > Literal[value!=/^(?:none|sm|md|lg)$/]",
        "message": "<GlassCard> elevation must be one of 'none' | 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|strokeWidth|style|className|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, strokeWidth, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|variant|size|dot|dotColor|ariaLabel|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, variant, size, dot, dotColor, ariaLabel, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:glass|navy|prism|plain)$/]",
        "message": "<IconButton> variant must be one of 'glass' | 'navy' | 'prism' | 'plain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|tint|size|iconColor|style|key|ref|className|style|children)$/]",
        "message": "<IconTile> doesn't accept that prop. Declared props: icon, tint, size, iconColor, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconTile'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconTile> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|trailing|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: icon, trailing, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRowStatus'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|label|key|ref|className|style|children)$/]",
        "message": "<ListRowStatus> doesn't accept that prop. Declared props: tone, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRowStatus'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:success|warning|live|reserved|info|free|busy|neutral)$/]",
        "message": "<ListRowStatus> tone must be one of 'success' | 'warning' | 'live' | 'reserved' | 'info' | 'free' | 'busy' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressRing'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|size|stroke|label|sublabel|style|key|ref|className|style|children)$/]",
        "message": "<ProgressRing> doesn't accept that prop. Declared props: value, max, size, stroke, label, sublabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|color|trailing|style|key|ref|className|style|children)$/]",
        "message": "<SectionLabel> doesn't accept that prop. Declared props: children, color, trailing, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpectrumTrack'] > JSXAttribute > JSXIdentifier[name!=/^(?:total|filled|dot|gap|colors|style|key|ref|className|style|children)$/]",
        "message": "<SpectrumTrack> doesn't accept that prop. Declared props: total, filled, dot, gap, colors, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|boxed|caps|pulse|style|key|ref|className|style|children)$/]",
        "message": "<StatusPill> doesn't accept that prop. Declared props: children, tone, boxed, caps, pulse, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:success|warning|live|reserved|info|free|busy|neutral)$/]",
        "message": "<StatusPill> tone must be one of 'success' | 'warning' | 'live' | 'reserved' | 'info' | 'free' | 'busy' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabBarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|icon|label|activeColor|key|ref|className|style|children)$/]",
        "message": "<TabBarItem> doesn't accept that prop. Declared props: id, icon, label, activeColor."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
